# Copy to .env and fill in. Real environment variables take precedence.
# Create API keys at https://create.roblox.com/dashboard/credentials

# Place to download with `npm run place:fetch` (uses your Studio login).
ROBLOX_PLACE_ID=

# `npm run assets:sync`. Permissions: asset:read, asset:write.
ASPHALT_API_KEY=

# `npm test`: uploads the test place and runs Jest in a Roblox server.
# Permissions: universe.places:write and
# universe.place.luau-execution-session:write on the test experience.
# Use a separate, private experience for tests.
ROBLOX_API_KEY=
ROBLOX_TEST_UNIVERSE_ID=
ROBLOX_TEST_PLACE_ID=
