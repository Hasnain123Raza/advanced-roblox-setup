{
	"name": "advanced-roblox-setup",
	"version": "0.0.0",
	"private": true,
	"description": "Roblox game template: roblox-ts, Rojo, and a full set of quality gates.",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"prepare": "lefthook install",
		"setup": "lune setup",
		"watch": "rbxtsc --watch",
		"serve": "rojo serve",
		"build": "rbxtsc && node -e \"fs.mkdirSync('build',{recursive:true})\" && rojo build default.project.json --output build/game.rbxl",
		"build:test-place": "rbxtsc && node -e \"fs.mkdirSync('build',{recursive:true})\" && rojo build test.project.json --output build/test.rbxl",
		"test": "npm run build:test-place && lune run run-tests",
		"check": "npm run format:check && npm run lint && npm run lint:luau && npm run lint:md && npm run lint:ci && npm run spell && npm run typecheck && npm run coverage:types && npm run knip && npm run docs && npm run assets:check && npm run build",
		"format": "prettier --write . && stylua lune tasks",
		"format:check": "prettier --check . && stylua --check lune tasks",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"lint:luau": "rbxtsc && selene lune tasks && lune run analyze",
		"lint:md": "markdownlint-cli2",
		"lint:ci": "actionlint",
		"spell": "cspell --no-progress --gitignore --dot .",
		"typecheck": "tsc --noEmit",
		"coverage:types": "type-coverage",
		"knip": "knip",
		"docs": "typedoc",
		"assets:sync": "asphalt sync",
		"assets:check": "asphalt sync cloud --dry-run",
		"place:fetch": "lune run fetch-place",
		"roblox:docs": "node -e \"const fs=require('fs'),{execSync}=require('child_process');if(!fs.existsSync('roblox-creator-docs/.git')){execSync('git clone --depth 1 https://github.com/Roblox/creator-docs roblox-creator-docs',{stdio:'inherit'});}else{execSync('git -C roblox-creator-docs pull --ff-only',{stdio:'inherit'});}\""
	},
	"typeCoverage": {
		"atLeast": 100,
		"strict": true,
		"detail": true,
		"ignoreCatch": true,
		"ignoreFiles": [
			"src/shared/assets/**"
		]
	},
	"devDependencies": {
		"@commitlint/cli": "21.2.4",
		"@commitlint/config-conventional": "21.2.4",
		"@eslint/js": "10.0.1",
		"@rbxts/compiler-types": "3.0.0-types.0",
		"@rbxts/jest": "3.16.0-ts.2",
		"@rbxts/jest-globals": "3.16.0-ts.2",
		"@rbxts/services": "1.6.0",
		"@rbxts/types": "1.0.962",
		"cspell": "10.5.1",
		"eslint": "10.15.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-jsdoc": "65.4.7",
		"eslint-plugin-roblox-ts": "1.4.1",
		"knip": "6.45.1",
		"lefthook": "2.2.2",
		"markdownlint-cli2": "0.24.1",
		"prettier": "3.10.1",
		"roblox-ts": "3.0.0",
		"type-coverage": "2.31.2",
		"typedoc": "0.28.20",
		"typescript": "5.5.3",
		"typescript-eslint": "8.72.2"
	}
}
