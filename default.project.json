{
	"name": "advanced-roblox-setup",
	"globIgnorePaths": [
		"**/package.json",
		"**/tsconfig.json",
		"**/__tests__",
		"**/__tests__/**",
		"**/jest.config.luau"
	],
	"tree": {
		"$className": "DataModel",
		"ServerScriptService": {
			"$className": "ServerScriptService",
			"TS": {
				"$path": "out/server"
			}
		},
		"ReplicatedStorage": {
			"$className": "ReplicatedStorage",
			"rbxts_include": {
				"$path": "include",
				"node_modules": {
					"$className": "Folder",
					"@rbxts": {
						"$path": "node_modules/@rbxts"
					}
				}
			},
			"TS": {
				"$path": "out/shared"
			},
			"Models": {
				"$path": "place/replicated-models"
			}
		},
		"ServerStorage": {
			"$className": "ServerStorage",
			"Models": {
				"$path": "place/server-models"
			}
		},
		"StarterPlayer": {
			"$className": "StarterPlayer",
			"$properties": {
				"CameraMaxZoomDistance": 128,
				"CharacterBreakJointsOnDeath": false,
				"CharacterUseJumpPower": false
			},
			"StarterPlayerScripts": {
				"$className": "StarterPlayerScripts",
				"TS": {
					"$path": "out/client"
				}
			}
		},
		"Workspace": {
			"$path": "place/Workspace.rbxm"
		},
		"Lighting": {
			"$path": "place/Lighting.rbxm"
		},
		"Players": {
			"$className": "Players",
			"$properties": {
				"RespawnTime": 3
			}
		},
		"StarterGui": {
			"$className": "StarterGui",
			"$properties": {
				"ScreenOrientation": "Sensor"
			}
		},
		"Teams": {
			"$className": "Teams"
		},
		"ProximityPromptService": {
			"$className": "ProximityPromptService"
		},
		"VoiceChatService": {
			"$className": "VoiceChatService"
		},
		"DataStoreService": {
			"$className": "DataStoreService"
		},
		"Chat": {
			"$className": "Chat",
			"$properties": {
				"BubbleChatEnabled": true
			}
		},
		"TextChatService": {
			"$path": "place/TextChatService.rbxm"
		},
		"HttpService": {
			"$className": "HttpService",
			"$properties": {
				"HttpEnabled": true
			}
		},
		"SoundService": {
			"$className": "SoundService",
			"$properties": {
				"RespectFilteringEnabled": true
			}
		}
	}
}
